{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../apartamenty-piwniczna-rynek-backend",
        "run",
        "start:dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "3001"
      ],
      "port": 3001, "autoPort": false
    }
  ]
}